# Your Discord Bot Token (Get this from Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# API Provider Configuration (OpenAI compatible API)
# The API key for your chosen provider
API_KEY=your_api_key_here

# The Base URL for the provider.
# Leave blank for OpenAI.
# For Deepseek: https://api.deepseek.com
# For OpenAI: https://api.openai.com/v1 (or leave blank)
# For local LLMs (like LM Studio/Ollama with OpenAI compatibility): http://localhost:1234/v1
API_BASE_URL=

# The model name you want to use
# e.g., deepseek-chat, gpt-3.5-turbo, gpt-4
MODEL_NAME=gpt-3.5-turbo

# Optional: Path to the soul file
# SOUL_FILE=soul.md